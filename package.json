  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/modules/freelance/service/index.ts",
    "./schemas": "./src/modules/freelance/schemas/index.ts",
    "./config": "./src/config/freelance.ts",
    "./ports": "./src/ports.ts",
    "./server": "./src/server/app.ts",
    "./db": "./src/db/owned.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@intgetion/kit": "github:theonyxiesss/intgetion-kit#v0.3.1",
    "drizzle-orm": "^0.45.3",
